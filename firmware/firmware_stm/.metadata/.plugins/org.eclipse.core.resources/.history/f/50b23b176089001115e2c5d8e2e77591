void Transmit_Train_Data(void)
{
    // Gửi đúng 2 giá trị pitch và roll (ép kiểu int) cách nhau bằng dấu phẩy
    sprintf(uart_buffer, "%d,%d\r\n", (int)pitch, (int)roll);
    HAL_UART_Transmit(&huart2, (uint8_t*)uart_buffer, strlen(uart_buffer), 100);
}

void Transmit_RAW_Data(void)
{
    // In ra 6 giá trị RAW cách nhau bằng dấu phẩy (chuẩn định dạng CSV)
    // Cấu trúc: ax, ay, az, gx, gy, gz
    sprintf(uart_buffer, "%d,%d,%d,%d,%d,%d\r\n",
            remote_data.ax,
            remote_data.ay,
            remote_data.az,
            remote_data.gx,
            remote_data.gy,
            remote_data.gz);

    HAL_UART_Transmit(&huart2, (uint8_t*)uart_buffer, strlen(uart_buffer), 100);
}

void Xe_DieuKhien_GocNghieng(void)
{
    // Ngưỡng góc nghiêng để kích hoạt chạy (tránh xe bị nhạy quá khi rung lắc nhẹ)
    float PThreshold = 28.0f;
    float RThreshold = 36.0f;

    // Tốc độ di chuyển mong muốn (Giá trị từ 0 đến 999)
    uint32_t TocDo = 600;
    uint32_t BeLai = 750;

    // 1. Chạy Tới (Nghiêng mạch về phía trước)
    if (pitch > PThreshold) {
        QuayToi();
        __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, TocDo);
        __HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_1, TocDo);
    }
    // 2. Chạy Lui (Nghiêng mạch về phía sau)
    else if (pitch < -PThreshold) {
        QuayLui();
        __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, TocDo);
        __HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_1, TocDo);
    }
    // 3. Rẽ Phải (Nghiêng mạch sang bên phải)
    else if (roll > RThreshold) {
        RePhai();
        __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, 0);
        __HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_1, BeLai);
    }
    // 4. Rẽ Trái (Nghiêng mạch sang bên trái)
    else if (roll < -RThreshold) {
        ReTrai();
        __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, BeLai);
        __HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_1, 0);
    }
    // 5. Đứng yên khi mạch cân bằng
    else {
        DungXe();
    }
}

