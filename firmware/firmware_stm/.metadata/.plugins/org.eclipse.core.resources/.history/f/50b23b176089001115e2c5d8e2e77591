void Read_ESP32_Data(void)
{
    // Khai báo bộ đệm 32 byte (đủ chứa 2 gói tin 16-byte liên tiếp)
    uint8_t buffer[32];

    // 1. DỌN DẸP LỖI UART (Tuyệt đối quan trọng để chống "đơ")
    // Xóa cờ lỗi Tràn bộ đệm (Overrun Error)
    __HAL_UART_CLEAR_OREFLAG(&huart6);
    // Xóa rác cũ trong Data Register để đảm bảo luôn đọc dữ liệu thời gian thực
    __HAL_UART_FLUSH_DRREGISTER(&huart6);

    // 2. ĐỌC NGUYÊN CỤC 32 BYTE TỪ ESP32
    // Đọc số lượng lớn giúp STM32 không bị kẹt trong hàm Receive quá lâu
    if (HAL_UART_Receive(&huart6, buffer, 32, 20) == HAL_OK)
    {
        // 3. QUÉT TÌM HEADER (0xAA 0xBB)
        // Quét từ cuối mảng ngược lên đầu (i--) để luôn bắt được gói tin MỚI NHẤT
        for (int i = 16; i >= 0; i--)
        {
            if (buffer[i] == 0xAA && buffer[i+1] == 0xBB)
            {
                // Bắt đúng Header! Copy 14 byte dữ liệu thực vào struct
                memcpy(&remote_data, &buffer[i+2], sizeof(ESP_Data_t));

                // --- TOÁN HỌC MPU6050 ---
                ax = remote_data.ax / 16384.0f;
                ay = remote_data.ay / 16384.0f;
                az = remote_data.az / 16384.0f;

                gx = remote_data.gx / 131.0f;
                gy = remote_data.gy / 131.0f;
                gz = remote_data.gz / 131.0f;

                // --- BỘ LỌC NHIỄU TĨNH ---
                if (fabs(gx) < 1.0f) gx = 0.0f;
                if (fabs(gy) < 1.0f) gy = 0.0f;
                if (fabs(gz) < 1.0f) gz = 0.0f;

                // --- TÍNH THỜI GIAN dt ---
                static uint32_t last_time = 0;
                uint32_t current_time = HAL_GetTick();
                float dt = 0.02f;
                if (last_time != 0) {
                    dt = (current_time - last_time) / 1000.0f;
                    if (dt > 0.1f) dt = 0.02f;
                }
                last_time = current_time;

                // --- BỘ LỌC BÙ CHUYỂN ĐỘNG ---
                float roll_acc = atan2f(ay, az) * 57.29578f;
                float pitch_acc = atan2f(-ax, sqrtf(ay * ay + az * az)) * 57.29578f;

                roll  = 0.96f * (roll  + gx * dt) + 0.04f * roll_acc;
                pitch = 0.96f * (pitch + gy * dt) + 0.04f * pitch_acc;
                yaw = yaw + gz * dt;

                // Đã xử lý xong gói tin mới nhất, thoát vòng lặp For ngay lập tức
                break;
            }
        }
    }
    else
    {
        // 4. RESET TRẠNG THÁI NẾU BỊ MẤT ĐỒNG BỘ
        // Ép UART sẵn sàng nhận lại nếu có bất kỳ lỗi nào xảy ra
        huart6.RxState = HAL_UART_STATE_READY;
    }
}
