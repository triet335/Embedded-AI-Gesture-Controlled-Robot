// --- BỘ NÃO AI MỚI (Dùng Góc Nghiêng) ---
int AI_Predict(float current_pitch, float current_roll) {
    // CHÚ Ý: BẠN HÃY PASTE CẤU TRÚC CÂY QUYẾT ĐỊNH TỪ PYTHON VÀO ĐÂY
    // Dưới đây chỉ là logic ví dụ tạm thời:
    if (current_pitch > -5118) {
        return 1; // Chạy Tới
    } else if (current_pitch < 528) {
        return 2; // Chạy Lùi
    } else if (current_roll > 6432) {
        return 4; // Rẽ Phải
    } else if (current_roll < 6546) {
        return 3; // Rẽ Trái
    } else {
        return 0; // Dừng Xe
    }
}

void Xe_DieuKhien_AI(void)
{
    uint32_t TocDo = 600;
    uint32_t BeLai = 750;

    // Đưa dữ liệu RAW vào bộ não AI để lấy kết quả
    int trang_thai = AI_Predict(pitch, roll);

    // Xử lý hành động dựa trên kết quả AI
    if (trang_thai == 0)
    {
        DungXe();
        sprintf(uart_buffer, ">>> TRANG THAI: DUNG\r\n");
        HAL_UART_Transmit(&huart2, (uint8_t*)uart_buffer, strlen(uart_buffer), 100);
    }
    else if (trang_thai == 1)
    {
        QuayToi();
        __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, TocDo);
        __HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_1, TocDo);

        sprintf(uart_buffer, ">>> TRANG THAI: Chay Toi\r\n");
        HAL_UART_Transmit(&huart2, (uint8_t*)uart_buffer, strlen(uart_buffer), 100);
    }
    else if (trang_thai == 2)
    {
        QuayLui();
        __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, TocDo);
        __HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_1, TocDo);

        sprintf(uart_buffer, ">>> TRANG THAI: Chay Lui\r\n");
        HAL_UART_Transmit(&huart2, (uint8_t*)uart_buffer, strlen(uart_buffer), 100);
    }
    else if (trang_thai == 3)
    {
        ReTrai();
        __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, BeLai);
        __HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_1, 0);

        sprintf(uart_buffer, ">>> TRANG THAI: Re Trai\r\n");
        HAL_UART_Transmit(&huart2, (uint8_t*)uart_buffer, strlen(uart_buffer), 100);
    }
    else if (trang_thai == 4)
    {
        RePhai();
        __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, 0);
        __HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_1, BeLai);

        sprintf(uart_buffer, ">>> TRANG THAI: Re Phai\r\n");
        HAL_UART_Transmit(&huart2, (uint8_t*)uart_buffer, strlen(uart_buffer), 100);
    }
}
